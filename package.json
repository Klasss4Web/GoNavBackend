{
  "name": "gonavapp",
  "private": true,
  "version": "1.0.0",
  "description": "GoNavApp",
  "repository": "",
  "license": "UNLICENSED",
  "proxy": "http://localhost:5000/",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production vite build && workbox injectManifest workbox-config.js",
    "build-capacitor-ios": "cross-env NODE_ENV=production vite build && npx cap copy ios",
    "build-capacitor-android": "cross-env NODE_ENV=production vite build && npx cap copy android",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
    "serve": "serve -s www",
    "preview": "vite preview"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/keyboard": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "dom7": "^4.0.6",
    "framer-motion": "^12.23.12",
    "framework7": "^8.3.4",
    "framework7-icons": "^5.0.5",
    "framework7-react": "^8.3.4",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "lrm-graphhopper": "^1.3.0",
    "material-icons": "^1.13.14",
    "mqtt": "^5.14.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "skeleton-elements": "^4.0.1",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@vitejs/plugin-react": "^5.0.0",
    "cordova-res": "^0.15.4",
    "cpy-cli": "^6.0.0",
    "cross-env": "^10.0.0",
    "postcss-preset-env": "^10.2.4",
    "vite": "^7.1.2",
    "workbox-cli": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
