{
  "id": "go-nav-app",
  "version": "1.0.0",
  "name": "GoNavApp",
  "short_name": "GoNavApp",
  "description": "Track buses in real time with our smart bus tracking app",
  "lang": "en-US",
  "start_url": "/",
  "scope": "/",
  "orientation": "any",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/icons/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/icons/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icons/favicon-96-96.png",
      "sizes": "96x96",
      "type": "image/png"
    },

    {
      "src": "/icons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/img/app-screenshot.png",
      "type": "image/png",
      "sizes": "422x838",
      "form_factor": "narrow"
    },
    {
      "src": "/assets/img/screenshot-desktop.png",
      "type": "image/png",
      "sizes": "1918x1021",
      "form_factor": "wide"
    }
  ],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "web_apps": [
    {
      "web_app_identity": ""
    }
  ],
  "handle_links": "auto",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "web+gonav",
      "url": "/?link=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "dir": "auto",
  "categories": ["books", "education", "games"],
  "permissions": ["periodic-background-sync"],
  "shortcuts": [
    {
      "name": "Bus Routes",
      "short_name": "Routes",
      "description": "Search all routes",
      "url": "/route-page/",
      "icons": [{ "src": "/icons/favicon-96-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Track Ride",
      "short_name": "Tracker",
      "description": "Track your ride",
      "url": "/track-map/",
      "icons": [{ "src": "/icons/favicon-96-96.png", "sizes": "96x96" }]
    }
  ],
  "widgets": [
    {
      "name": "Browse Bus Routes",
      "description": "Quick access to all routes",
      "url": "/route-page/",
      "icons": [
        {
          "src": "/icons/favicon-96-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
