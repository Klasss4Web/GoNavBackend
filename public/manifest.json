{
  "id": "go-nav-app",
  "version": "1.0.0",
  "name": "GoNavApp",
  "short_name": "GoNavApp",
  "description": "GoNavApp",
  "lang": "en-US",
  "start_url": "/",
  "scope": "/",
  "orientation": "any",
  "display": "standalone",
  "background_color": "#EE350F",
  "theme_color": "#EE350F",
  "icons": [
    {
      "src": "/icons/128x128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icons/144x144.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "/icons/152x152.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "/icons/192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/256x256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/icons/512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "web_apps": [
    {
      "web_app_identity": ""
    }
  ],
  "handle_links": "auto",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "web+gonav",
      "url": "/?link=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "dir": "auto",
  "categories": ["books", "education", "games"],
  "permissions": ["periodic-background-sync"],
  "shortcuts": [
    {
      "name": "Bus Routes",
      "short_name": "Routes",
      "description": "Search all routes",
      "url": "/route-page/",
      "icons": [{ "src": "/icons/favicon.png", "sizes": "96x96" }]
    },
    {
      "name": "Track Ride",
      "short_name": "Tracker",
      "description": "Track your ride",
      "url": "/track-map/",
      "icons": [{ "src": "/icons/compass.png", "sizes": "96x96" }]
    }
  ],
  "widgets": [
    {
      "name": "Browse Bus Routes",
      "description": "Quick access to all routes",
      "url": "/route-page/",
      "icons": [
        { "src": "/icons/favicon.png", "sizes": "96x96", "type": "image/png" }
      ]
    }
  ]
}
